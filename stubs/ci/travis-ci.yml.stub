language: php

php:
  - 8.4

services:
  - docker

env:
  global:
    - REGISTRY=__REPOSITORY__
    - ORGANIZATION=__ORGANIZATION__
    - APP_NAME=__APP_NAME__

branches:
  only:
    - main
    - master
    - /^v.*/

before_install:
  - composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev

before_script:
  - |
    if [ -n "$GHCR_IO_USERNAME" ] && [ -n "$GHCR_IO_PASSWORD" ]; then
      echo "$GHCR_IO_PASSWORD" | docker login $REGISTRY -u "$GHCR_IO_USERNAME" --password-stdin
    elif [ -n "$REGISTRY_USERNAME" ] && [ -n "$REGISTRY_PASSWORD" ]; then
      echo "$REGISTRY_PASSWORD" | docker login $REGISTRY -u "$REGISTRY_USERNAME" --password-stdin
    fi

script:
  - |
    if [ -n "$TRAVIS_TAG" ]; then
      VERSION=${TRAVIS_TAG#v}
    else
      VERSION=$(date +'%Y.%m.%d')-${TRAVIS_COMMIT:0:8}
    fi
  - |
    # Frontend build-time configuration. Bundlers inline VITE_* values during the
    # image build, so a runtime env var is too late. Define these as repository
    # environment variables (encrypt SENTRY_AUTH_TOKEN); unset values stay empty
    # and Sail drops them.
    export VITE_SENTRY_DSN="${VITE_SENTRY_DSN:-}"
    export VITE_SENTRY_RELEASE="${VITE_SENTRY_RELEASE:-$VERSION}"
    export SENTRY_ORG="${SENTRY_ORG:-}"
    export SENTRY_PROJECT="${SENTRY_PROJECT:-}"
    export SENTRY_AUTH_TOKEN="${SENTRY_AUTH_TOKEN:-}"
  - |
    php artisan sail:build \
      --environments=production \
      --architectures=linux/amd64,linux/arm64 \
      --repository=$REGISTRY \
      --organization=$ORGANIZATION \
      --build-version=$VERSION \
      --push \
      --use-previous \
      --bump=no

