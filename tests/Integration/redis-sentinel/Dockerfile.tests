# Tiny PHP-with-phpredis image for the Phase 3 integration test. Runs phpunit
# inside the same docker network as the redis-sentinel stack so Sentinel-resolved
# master IPs (which are container-network addresses) are reachable.
FROM php:8.4-cli-alpine

RUN apk add --no-cache --virtual .build-deps autoconf gcc g++ make linux-headers \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps

WORKDIR /app
