#!/usr/bin/env bash

UNAMEOUT="$(uname -s)"
DOMAIN=$(grep -E '^APP_URL=' .env | cut -d '=' -f2 | sed 's|http[s]*://||' | cut -d '/' -f1 | tr -d '"')
SAIL_IP=$(grep -E '^SAIL_BIND_IP=' .env | cut -d '=' -f2 | sed 's|http[s]*://||' | cut -d '/' -f1 | tr -d '"')
if [ -z "$SAIL_IP" ]; then
    SAIL_IP=$(grep -E '^SAIL_IP=' .env | cut -d '=' -f2 | sed 's|http[s]*://||' | cut -d '/' -f1 | tr -d '"')
fi
SAIL_NETWORK_MODE=$(grep -E '^SAIL_NETWORK_MODE=' .env | cut -d '=' -f2 | tr -d '"')
SAIL_NETWORK_MODE=${SAIL_NETWORK_MODE:-local}
SAIL_NETWORK_TLS=$(grep -E '^SAIL_NETWORK_TLS=' .env | cut -d '=' -f2 | tr -d '"')
SAIL_NETWORK_TLS=${SAIL_NETWORK_TLS:-true}
SAIL_HOME_DIR=${SAIL_HOME:-"$HOME/.config/sail"}
# Only the shared 'lan' mode multiplexes projects behind one proxy that mounts a
# shared certs dir. 'local' and 'lan-direct' each run their OWN per-project
# nginx-proxy (compose.stub), which mounts the vendor certs dir.
if [ "$SAIL_NETWORK_MODE" = "lan" ]; then
    SHARED_CERTS=1
    CERT_TARGET="$SAIL_HOME_DIR/certs"
    mkdir -p "$CERT_TARGET"
else
    SHARED_CERTS=0
    CERT_TARGET="vendor/reyemtech/sail/certs"
fi

# Verify operating system is supported...
case "${UNAMEOUT}" in
Linux*) MACHINE=linux ;;
Darwin*) MACHINE=mac ;;
*) MACHINE="UNKNOWN" ;;
esac

if [ "$MACHINE" == "UNKNOWN" ]; then
    echo "Unsupported operating system [$(uname -s)]. Laravel Sail supports macOS, Linux, and Windows (WSL2)." >&2

    exit 1
fi

# Determine if stdout is a terminal...
if test -t 1; then
    # Determine if colors are supported...
    ncolors=$(tput colors)

    if test -n "$ncolors" && test "$ncolors" -ge 8; then
        BOLD="$(tput bold)"
        YELLOW="$(tput setaf 3)"
        GREEN="$(tput setaf 2)"
        RED="$(tput setaf 1)"
        ORANGE="$(tput setaf 6)"
        BLUE="$(tput setaf 4)"
        NC="$(tput sgr0)"
    fi
fi

function header() {
    # Print a header message...
    echo ""
    echo "${BOLD}${BLUE}===============================================${NC}"
    echo "${BOLD}${BLUE} $1 ${NC}"
    echo "${BOLD}${BLUE}===============================================${NC}"
    echo ""
}

function success {
    # Print a success message...
    echo "${GREEN}==> $1${NC} $2"
}
function error {
    # Print an error message...
    echo "${RED}==> $1${NC} $2" >&2
}
function warning {
    # Print a warning message...
    echo "${BLUE}==> $1${NC} $2"
}
function info {
    # Print an info message...
    echo "${YELLOW}==> $1${NC} $2"
}

function create_ip_alias {
    header "Creating IP alias for $SAIL_IP"

    # Create an IP alias for the host machine using the SAIL_IP from the .env file...
    if [ -z "$SAIL_IP" ]; then
        echo "{$RED}SAIL_IP is not defined in the .env file. Exiting.${NC}" >&2
        exit 1
    fi

    if [ "$MACHINE" == "mac" ]; then
        if ! ifconfig lo0 | grep -q "$SAIL_IP"; then
            sudo ifconfig lo0 alias $SAIL_IP
            success "IP alias created:" "$SAIL_IP"
        else
            info "IP alias already exists:" "$SAIL_IP"
        fi
    elif [ "$MACHINE" == "linux" ]; then
        if ! ip addr show dev lo | grep -q "$SAIL_IP"; then
            sudo ip addr add $SAIL_IP/32 dev lo
            success "IP alias created:" "$SAIL_IP"
        else
            info "IP alias already exists:" "$SAIL_IP"
        fi
    fi
}

function create_lan_ip_alias {
    header "Creating LAN IP alias for $SAIL_IP"

    # lan-direct binds a DISTINCT real LAN IP per project by aliasing it onto the
    # host's default-route interface (NOT loopback), so other devices reach it on
    # standard ports. Requires root; not Docker-Desktop-compatible.
    if [ -z "$SAIL_IP" ]; then
        error "SAIL_IP is not defined in the .env file. Exiting."
        exit 1
    fi

    if [ "$MACHINE" == "mac" ]; then
        LAN_IFACE=$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')
        if [ -z "$LAN_IFACE" ]; then
            error "Could not determine the default LAN interface. Alias $SAIL_IP manually."
            exit 1
        fi
        if ifconfig "$LAN_IFACE" 2>/dev/null | grep -q "$SAIL_IP"; then
            info "LAN IP alias already exists on $LAN_IFACE:" "$SAIL_IP"
        else
            sudo ifconfig "$LAN_IFACE" alias "$SAIL_IP"
            success "LAN IP alias created on $LAN_IFACE:" "$SAIL_IP"
        fi
    elif [ "$MACHINE" == "linux" ]; then
        LAN_IFACE=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
        if [ -z "$LAN_IFACE" ]; then
            error "Could not determine the default LAN interface. Alias $SAIL_IP manually."
            exit 1
        fi
        if ip addr show dev "$LAN_IFACE" 2>/dev/null | grep -q "$SAIL_IP"; then
            info "LAN IP alias already exists on $LAN_IFACE:" "$SAIL_IP"
        else
            sudo ip addr add "$SAIL_IP"/24 dev "$LAN_IFACE"
            success "LAN IP alias created on $LAN_IFACE:" "$SAIL_IP"
        fi
    fi

    info "lan-direct: skipping /etc/hosts ($DOMAIN resolves via nip.io/.local)." ""
}

function add_hosts_entry {
    create_ip_alias

    header "Adding entry to /etc/hosts for $DOMAIN"

    if grep -q "$SAIL_IP" /etc/hosts || grep -q "$DOMAIN" /etc/hosts; then
        sudo sed -i.bak "/$SAIL_IP/d" /etc/hosts
        sudo sed -i.bak "/$DOMAIN/d" /etc/hosts
        info "Existing entry removed from" "/etc/hosts"
    fi

    echo "$SAIL_IP  $DOMAIN" | sudo tee -a /etc/hosts >/dev/null

    success "Entry added to /etc/hosts:" "$SAIL_IP  $DOMAIN"
}

function install_brew {
    # Install Homebrew on macOS...
    if [ "$MACHINE" == "mac" ]; then
        if ! command -v brew &>/dev/null; then
            header "Installing Homebrew"
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            success "Homebrew installed successfully."
        fi
    fi
}

function install_docker {
    # Install Docker on macOS...
    if [ "$MACHINE" == "mac" ]; then
        if !command -v brew &>/dev/null; then
            install_brew
        fi
        if ! command -v docker &>/dev/null; then
            header "Installing Docker"
            brew install --cask docker
            success "Docker installed successfully."
        fi
    fi
}

function install_mkcert {
    if [ -z "$(command -v mkcert)" ]; then
        header "Installing mkcert"

        if [ "$MACHINE" == "mac" ]; then
            if !command -v brew &>/dev/null; then
                install_brew
            fi
            brew install mkcert
            brew install nss # For Firefox support

        elif [ "$MACHINE" == "linux" ]; then
            if command -v apt-get &>/dev/null; then
                sudo apt-get update
                sudo apt-get install -y libnss3-tools
                curl -JLO "https://dl.filippo.io/mkcert/latest?for=linux/amd64"
                chmod +x mkcert-v*-linux-amd64
                sudo mv mkcert-v*-linux-amd64 /usr/local/bin/mkcert
            elif command -v yum &>/dev/null; then
                sudo yum install -y nss-tools
                curl -JLO "https://dl.filippo.io/mkcert/latest?for=linux/amd64"
                chmod +x mkcert-v*-linux-amd64
                sudo mv mkcert-v*-linux-amd64 /usr/local/bin/mkcert
            else
                error "Unsupported Linux package manager. Please install mkcert manually."
                exit 1
            fi
        else
            error "Unsupported operating system. Please install mkcert manually."
            exit 1
        fi
        success "mkcert installed successfully."
    fi
}

function generate_certificates {
    install_mkcert

    header "Generating SSL certificates for $DOMAIN"
    # Generate SSL certificates for the host machine using mkcert...

    CERT_FOLDER="$CERT_TARGET"

    if [ ! -f "$CERT_FOLDER/$DOMAIN.crt" ] || [ ! -f "$CERT_FOLDER/$DOMAIN.key" ] ||
        ! openssl x509 -checkend 86400 -noout -in "$CERT_FOLDER/$DOMAIN.crt" >/dev/null 2>&1; then
        [ -d "$CERT_FOLDER" ] || mkdir -p "$CERT_FOLDER"
        mkcert -install >/dev/null 2>&1
        mkcert -cert-file "$CERT_FOLDER/$DOMAIN.crt" -key-file "$CERT_FOLDER/$DOMAIN.key" "$DOMAIN" "minio" >/dev/null 2>&1
        # In shared lan mode the certs dir is shared across projects, so the
        # generic public.crt/private.key would collide (last project wins). Only
        # the per-domain <domain>.crt/.key are written there; per-project modes
        # (local, lan-direct) keep the generic pair for their runtime mount.
        if [ "$SHARED_CERTS" = "0" ]; then
            cp "$CERT_FOLDER/$DOMAIN.crt" "$CERT_FOLDER/public.crt"
            cp "$CERT_FOLDER/$DOMAIN.key" "$CERT_FOLDER/private.key"
        fi
        cp "$(mkcert -CAROOT)/rootCA.pem" "$CERT_FOLDER/mkcert-rootCA.pem"

        success "Certificates created or renewed successfully in the ${NC}$CERT_FOLDER${GREEN} folder."
    else
        info "Certificates are valid and not expired. Skipping creation."
    fi

    if [ "$SHARED_CERTS" = "0" ]; then
        LINK_FOLDERS=(
            "vendor/reyemtech/sail/runtimes/8.x"
        )
        for folder in "${LINK_FOLDERS[@]}"; do
            rm -rf "$(pwd)/$folder/certs"
            cp -fr "$(pwd)/$CERT_FOLDER" "$(pwd)/$folder"
        done
    fi
}

function link_application {
    header "Linking application directory to Sail container"
    # Link the application directory to the Sail container...
    if [ ! -d "vendor/reyemtech/sail/runtimes/8.x/app" ]; then
        ln -s "$(pwd)" "vendor/reyemtech/sail/runtimes/8.x/app"
        success "Linked application directory to Sail container."
    else
        info "Application directory already linked to Sail container."
    fi
}

install_brew
install_docker
if [ "$SAIL_NETWORK_MODE" = "local" ]; then
    add_hosts_entry
elif [ "$SAIL_NETWORK_MODE" = "lan-direct" ]; then
    create_lan_ip_alias
else
    echo "${GREEN}LAN mode: skipping loopback alias and /etc/hosts (binding ${SAIL_IP}, domain ${DOMAIN}).${NC}" >&2
fi
case "$SAIL_NETWORK_TLS" in
false | 0 | no | off | FALSE | False | NO | Off | OFF)
    echo "${GREEN}Plain-HTTP mode (SAIL_NETWORK_TLS=${SAIL_NETWORK_TLS}): skipping mkcert certificate generation.${NC}" >&2
    ;;
*)
    generate_certificates
    ;;
esac
# link_application

echo ""
echo "${BOLD}${GREEN}===============================================${NC}"
echo "${BOLD}${GREEN} Sail setup completed successfully! ${NC}"
echo "${BOLD}${GREEN}===============================================${NC}"
echo ""
